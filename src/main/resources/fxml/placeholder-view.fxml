<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senkoje.presentation.controller.PlaceholderViewController"
      styleClass="screen-container"
      alignment="CENTER"
      spacing="14">

    <VBox styleClass="empty-state" maxWidth="620">
        <Label fx:id="titleLabel" styleClass="screen-title" wrapText="true"/>
        <Label fx:id="subtitleLabel" styleClass="screen-subtitle" wrapText="true" textAlignment="CENTER"/>
        <Label fx:id="noteLabel" styleClass="muted-label" wrapText="true" textAlignment="CENTER"/>
    </VBox>
</VBox>
