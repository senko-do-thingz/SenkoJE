<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senkoje.presentation.controller.CardBrowserController"
      styleClass="screen-container"
      spacing="14">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="titleLabel" styleClass="screen-title"/>
            <Label fx:id="subtitleLabel" styleClass="screen-subtitle"/>
        </VBox>
        <Button fx:id="refreshButton" styleClass="secondary-button" onAction="#handleRefresh"/>
        <Button fx:id="newCardButton" styleClass="primary-button" onAction="#handleCreateCard"/>
    </HBox>

    <HBox styleClass="card-panel" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="deckFilterBox" prefWidth="175"/>
        <ComboBox fx:id="typeFilterBox" prefWidth="160"/>
        <ComboBox fx:id="levelFilterBox" prefWidth="145"/>
        <ComboBox fx:id="statusFilterBox" prefWidth="165"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="selectionCountLabel" styleClass="muted-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" styleClass="secondary-button" onAction="#handleEditSelected" disable="true"/>
        <Button fx:id="suspendButton" styleClass="secondary-button" onAction="#handleSuspendSelected" disable="true"/>
        <Button fx:id="unsuspendButton" styleClass="secondary-button" onAction="#handleUnsuspendSelected" disable="true"/>
        <Button fx:id="deleteButton" styleClass="danger-button" onAction="#handleDeleteSelected" disable="true"/>
    </HBox>

    <SplitPane dividerPositions="0.69" VBox.vgrow="ALWAYS">
        <TableView fx:id="cardsTable">
            <columns>
                <TableColumn fx:id="termColumn" minWidth="90" prefWidth="110"/>
                <TableColumn fx:id="readingColumn" minWidth="85" prefWidth="100"/>
                <TableColumn fx:id="meaningColumn" minWidth="110" prefWidth="135"/>
                <TableColumn fx:id="typeColumn" minWidth="78" prefWidth="86"/>
                <TableColumn fx:id="levelColumn" minWidth="78" prefWidth="80"/>
                <TableColumn fx:id="deckColumn" minWidth="95" prefWidth="110"/>
                <TableColumn fx:id="statusColumn" minWidth="115" prefWidth="120"/>
            </columns>
        </TableView>

        <ScrollPane fitToWidth="true">
            <VBox fx:id="previewPane" styleClass="card-panel" spacing="10">
                <Label fx:id="previewTitleLabel" styleClass="section-title"/>
                <Label fx:id="previewEmptyLabel" styleClass="muted-label" wrapText="true"/>
                <VBox fx:id="previewContentBox" spacing="10" visible="false" managed="false"/>
            </VBox>
        </ScrollPane>
    </SplitPane>
</VBox>
