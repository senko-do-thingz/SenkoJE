<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.senkoje.presentation.controller.MainShellController"
            fx:id="rootPane"
            styleClass="app-root">

    <left>
        <VBox fx:id="sidebarPane" styleClass="sidebar" prefWidth="230" spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox fx:id="brandBox" spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="brandLabel" styleClass="sidebar-brand"/>
                    <Label fx:id="taglineLabel" styleClass="sidebar-tagline" wrapText="true"/>
                </VBox>
                <Button fx:id="toggleSidebarButton" styleClass="sidebar-toggle-button"
                        minWidth="32" prefWidth="32" minHeight="30" prefHeight="30"
                        onAction="#handleToggleSidebar"/>
            </HBox>

            <Separator/>

            <VBox fx:id="navigationList" spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboardButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateDashboard"/>
                <Button fx:id="navDecksButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateDecks"/>
                <Button fx:id="navStudyButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateStudy"/>
                <Button fx:id="navReadingButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateReading"/>
                <Button fx:id="navCardsButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateCards"/>
                <Button fx:id="navImportExportButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateImportExport"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Separator/>
                <Button fx:id="navSettingsButton" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#handleNavigateSettings"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentHost" styleClass="content-host"/>
    </center>
</BorderPane>
